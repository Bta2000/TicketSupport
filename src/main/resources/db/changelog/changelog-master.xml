<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1-create-table-14050516" author="bita">
        <createTable tableName="ticket_support" schemaName="support">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="شناسه تیکت">
                <constraints nullable="false" primaryKey="true"
                primaryKeyName="pk_ticket_id"/>
            </column>

            <column name="title" type="varchar(100)" remarks="عنوان تیکت">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT" remarks="توضیحات">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(50)" defaultValue="OPEN" remarks="وضعیت تیکت">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>
</databaseChangeLog>